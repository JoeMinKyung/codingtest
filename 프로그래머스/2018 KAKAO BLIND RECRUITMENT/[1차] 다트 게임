def solution(dartResult):
    answer = 0
    scores = []
    current_score = 0
    current_bonus = ""
    i = 0

    while i < len(dartResult):
        char = dartResult[i]

        if char.isdigit():
            if current_bonus:
                scores.append(apply_bonus(current_score, current_bonus))
            current_score = int(char)
            if i + 1 < len(dartResult) and dartResult[i + 1] == "0":
                current_score = 10
                i += 1
            current_bonus = ""

        elif char in "SDT":
            current_bonus = char

        elif char in "*#":
            current_score = apply_bonus(current_score, current_bonus)
            if char == "*":
                if scores:
                    scores[-1] *= 2
                current_score *= 2
            elif char == "#":
                current_score *= -1
            scores.append(current_score)
            current_score = 0
            current_bonus = ""

        i += 1

    scores.append(apply_bonus(current_score, current_bonus))
    answer = sum(scores)
    return answer


def apply_bonus(score, bonus):
    if bonus == "S":
        return score**1
    elif bonus == "D":
        return score**2
    elif bonus == "T":
        return score**3
    return score
